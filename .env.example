# Copy this file to .env and change the password. .env is never committed.

# Password of the PostgreSQL account in Docker: letters and numbers only (no spaces or quotes,
# which would break the connection string). Used when the database is first created.
DB_PASSWORD=ChangeMe2026

# Signs the login cookie: any long random text (32 characters or more), kept secret. The site
# refuses to start with this example value. One way to make one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text

# Optional: a Twitch developer app (https://dev.twitch.tv/console/apps), only to look up new
# games on IGDB (summaries, covers, trailers). The demo data already has this information.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: a Steam Web API key (https://steamcommunity.com/dev/apikey), only for /collection's
# "Importar da Steam"
STEAM_API_KEY=

# Optional: e-mail, for "forgot your password?". Any provider's SMTP server (STARTTLS, port 587).
# Without SMTP_HOST nothing is sent: the e-mail (with its link) is only written to the site's log.
# SITE_URL is the site's address as people open it: the links in e-mails point there.
SITE_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Only on a server (docker-compose.production.yml, DEPLOY.md): the site's address, for the HTTPS
# certificate (SITE_URL is then made from it), and where a daily run's problems are e-mailed
# (a store failed or half-broken; needs SMTP_HOST).
# DOMAIN=203-0-113-5.sslip.io
# ALERT_EMAIL=
